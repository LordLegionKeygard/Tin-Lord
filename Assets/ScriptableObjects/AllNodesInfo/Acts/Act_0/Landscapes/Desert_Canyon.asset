  DescriptionWrappers:
  - PanelHeight: 140
    Description: "Deep cracks in the earth, sun-baked rocks and narrow passages where
      every sound echoes. \n\nOnce rivers flowed here and life seethed, but now it
      is a labyrinth of stone and shadow, the perfect place for ambushes."
  - PanelHeight: 160
    Description: "\u0413\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B
      \u0432 \u0437\u0435\u043C\u043B\u0435, \u0432\u044B\u0436\u0436\u0435\u043D\u043D\u044B\u0435
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C \u0441\u043A\u0430\u043B\u044B \u0438
      \u0443\u0437\u043A\u0438\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B,
      \u0433\u0434\u0435 \u044D\u0445\u043E \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442
      \u043B\u044E\u0431\u043E\u0439 \u0437\u0432\u0443\u043A. \n\n\u041A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u0442\u0435\u043A\u043B\u0438 \u0440\u0435\u043A\u0438
      \u0438 \u0431\u0443\u0440\u043B\u0438\u043B\u0430 \u0436\u0438\u0437\u043D\u044C,
      \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C - \u044D\u0442\u043E \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442
      \u0438\u0437 \u043A\u0430\u043C\u043D\u044F \u0438 \u0442\u0435\u043D\u0438,
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u0437\u0430\u0441\u0430\u0434."
