  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430,
    \u043E\u043F\u0430\u043B\u0451\u043D\u043D\u044B\u0435 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u043E\u0439,
    \u0433\u0434\u0435 \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u043A\u0438\u043F\u0435\u043B\u0430
    \u0436\u0438\u0437\u043D\u044C. \u042D\u0442\u043E \u043C\u0438\u0440 \u043C\u0451\u0440\u0442\u0432\u043E\u0439
    \u0437\u0435\u043C\u043B\u0438, \u0443\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
    \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C\u0438 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0439. \u0417\u0434\u0435\u0441\u044C
    \u043D\u0435\u0442 \u0432\u043E\u0434\u044B, \u043B\u0438\u0448\u044C \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u0439\u0441\u044F
    \u0433\u0440\u0443\u043D\u0442 \u0438 \u0440\u0436\u0430\u0432\u044B\u0435 \u043E\u0441\u0442\u0430\u043D\u043A\u0438
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e1b157f1f8f6ba142909c14d51ee7c09, type: 2}
